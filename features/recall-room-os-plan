#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Documents/recall-room-os-session-plans"
file="$HOME/Documents/recall-room-os-session-plans/plan-$(date +%Y%m%d-%H%M%S).md"
{
 printf '# recall-room-os session plan\n\n'
 printf 'Created: %s\n\n' "$(date -Is)"
 printf 'Purpose: exam preparation\n\n## Prompts\n'
 printf '%s\n' '- What outcome are you aiming for?' '- What is the next small action?' '- What resources or constraints matter?'
 printf '\n## Notes\n'
} > "$file"
nano "$file"
printf 'Saved locally: %s\n' "$file"
